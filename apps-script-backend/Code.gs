/** @OnlyCurrentDoc */

var RadioCore = (function () {
  'use strict';
  var version = 'radio-1';
  var questions = [
    ['a1','pick',2],['a2','pick',4],['a3','scale',5],['a4','pick',4],['a5','scale',5],['a6','pick',2],
    ['b1','pick',2],['b2','pick',4],['b3','scale',5],['b4','pick',4],['b5','scale',5],['b6','pick',2],
    ['c1','pick',2],['c2','pick',4],['c3','scale',5],['c4','pick',4],['c5','scale',5],['c6','pick',2],
    ['d1','pick',2],['d2','pick',4],['d3','scale',5],['d4','pick',4],['d5','scale',5],['d6','pick',2]
  ];
  var map={};questions.forEach(function(q){map[q[0]]={id:q[0],type:q[1],choices:q[2]};});
  function nickname(value){var s=String(value||'').trim().normalize('NFC');if(!s||Array.from(s).length>16||/[\u0000-\u001f\u007f<>\r\n]/.test(s)||/^[=+\-@]/.test(s))throw Error('暱稱請用 1–16 個字，不要以 =、+、-、@ 開頭。');return s;}
  function valid(ids,answers){return Array.isArray(ids)&&[8,12].indexOf(ids.length)>=0&&new Set(ids).size===ids.length&&Array.isArray(answers)&&answers.length===ids.length&&ids.every(function(id,i){var q=map[id];return q&&Number.isInteger(answers[i])&&answers[i]>=0&&answers[i]<q.choices;});}
  function score(ids,host,guest){if(!valid(ids,host)||!valid(ids,guest))throw Error('答案格式不正確');var points=ids.map(function(id,i){return map[id].type==='scale'?100-25*Math.abs(host[i]-guest[i]):host[i]===guest[i]?100:0;});return {score:Math.round(points.reduce(function(a,b){return a+b;},0)/ids.length),points:points};}
  return {version:version,nickname:nickname,valid:valid,score:score};
})();

var CHANNEL_SHEET_='頻道';
var PLAYER_SHEET_='玩家紀錄';
var RANK_SHEET_='排行榜';
var CHANNEL_HEADERS_=['頻道代碼','出題者暱稱','頭像代碼','題目代碼JSON','答案JSON','建立時間','有效期限','題目版本','請求識別碼'];
var PLAYER_HEADERS_=['紀錄ID','頻道代碼','玩家暱稱','頭像代碼','默契分數','題數','完成時間','題目版本','答案JSON','請求識別碼'];
var RANK_HEADERS_=['名次','頻道代碼','出題者暱稱','玩家暱稱','默契%','題數','完成時間','紀錄ID'];
var AVATARS_=['🐰','🐻','🐱','🦊','🐼'];

function doGet(e){
  if(e&&e.parameter&&e.parameter.api){
    var callback=String(e.parameter.callback||'');
    if(!/^[A-Za-z_$][A-Za-z0-9_$]{0,64}$/.test(callback))return ContentService.createTextOutput('Invalid callback').setMimeType(ContentService.MimeType.TEXT);
    var result;
    if(e.parameter.api==='channel')result=rpc({action:'getChannel',payload:{id:e.parameter.id}});
    else if(e.parameter.api==='status')result=requestStatus_(e.parameter.requestId);
    else result={ok:false,error:'不支援的操作'};
    return javascriptOutput_(callback,result);
  }
  var page=Utilities.newBlob(Utilities.base64Decode('')).getDataAsString('UTF-8');
  return HtmlService.createHtmlOutput(page)
    .setTitle('默契電台｜你們有多同頻？')
    .addMetaTag('viewport','width=device-width, initial-scale=1');
}

function doPost(e){
  var result,requestId='';
  try{
    var request=JSON.parse(String(e&&e.parameter&&e.parameter.payload||''));
    requestId=String(request&&request.payload&&request.payload.requestId||'');
    result=rpc(request);
  }catch(error){result={ok:false,error:'請求格式不正確'};}
  if(/^[A-Za-z0-9-]{12,80}$/.test(requestId))CacheService.getScriptCache().put('rpc:'+requestId,JSON.stringify(result),600);
  return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);
}

function javascriptOutput_(callback,value){
  var json=JSON.stringify(value).replace(/</g,'\\u003c').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');
  return ContentService.createTextOutput(callback+'('+json+');').setMimeType(ContentService.MimeType.JAVASCRIPT);
}

function requestStatus_(rawRequestId){
  var requestId=validRequestId_(rawRequestId),cached=CacheService.getScriptCache().get('rpc:'+requestId);if(cached)return JSON.parse(cached);
  ensureSheets_();
  var channelRows=dataRows_(SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CHANNEL_SHEET_),CHANNEL_HEADERS_.length);
  for(var i=0;i<channelRows.length;i++)if(String(channelRows[i][8])===requestId)return {ok:true,data:{id:String(channelRows[i][0]),expiresAt:iso_(channelRows[i][6]),leaderboard:getLeaderboard_(String(channelRows[i][0])),baseUrl:webAppUrl_()}};
  var playerRows=dataRows_(SpreadsheetApp.getActiveSpreadsheet().getSheetByName(PLAYER_SHEET_),PLAYER_HEADERS_.length);
  for(var j=0;j<playerRows.length;j++)if(String(playerRows[j][9])===requestId){
    var channel=findChannelRow_(String(playerRows[j][1]));if(!channel)return {ok:false,error:'找不到原始頻道。'};
    var ids=parseJsonArray_(channel[3]),host=parseJsonArray_(channel[4]),guest=parseJsonArray_(playerRows[j][8]),score=RadioCore.score(ids,host,guest);
    return {ok:true,data:{score:score.score,points:score.points,hostAnswers:host,guestAnswers:guest,leaderboard:getLeaderboard_(String(channel[0]))}};
  }
  return {pending:true};
}

function rpc(request){
  try{
    if(!request||typeof request!=='object')throw Error('請求格式不正確');
    var size=JSON.stringify(request).length;if(size>12000)throw Error('資料量超過限制');
    ensureSheets_();cleanupExpired_();
    var action=String(request.action||''),payload=request.payload||{},data;
    if(action==='createChannel')data=createChannel_(payload);
    else if(action==='getChannel')data=getChannelPublic_(payload.id);
    else if(action==='submitGuess')data=submitGuess_(payload);
    else throw Error('不支援的操作');
    return {ok:true,data:data};
  }catch(error){return {ok:false,error:String(error&&error.message||error).slice(0,180)};}
}

function ensureSheets_(){
  var ss=SpreadsheetApp.getActiveSpreadsheet();
  if(!ss)throw Error('請將程式綁定在「默契電台－玩家與排名紀錄」試算表。');
  ensureSheet_(ss,CHANNEL_SHEET_,CHANNEL_HEADERS_);
  ensureSheet_(ss,PLAYER_SHEET_,PLAYER_HEADERS_);
  ensureSheet_(ss,RANK_SHEET_,RANK_HEADERS_);
}

function ensureSheet_(ss,name,headers){
  var sheet=ss.getSheetByName(name)||ss.insertSheet(name);
  var current=sheet.getRange(1,1,1,headers.length).getDisplayValues()[0];
  if(current.join('|')!==headers.join('|')){
    if(sheet.getLastRow()>1)throw Error('「'+name+'」欄位已被修改，為避免覆蓋資料已停止寫入。');
    sheet.getRange(1,1,1,headers.length).setValues([headers]);
  }
  sheet.setFrozenRows(1);
  sheet.getRange(1,1,1,headers.length).setBackground('#e7e7e7').setFontColor('#111111').setFontWeight('bold');
  if(name===CHANNEL_SHEET_)sheet.getRange('F:G').setNumberFormat('yyyy-mm-dd hh:mm');
  if(name===PLAYER_SHEET_)sheet.getRange('G:G').setNumberFormat('yyyy-mm-dd hh:mm');
  if(name===RANK_SHEET_)sheet.getRange('G:G').setNumberFormat('yyyy-mm-dd hh:mm');
}

function createChannel_(p){
  return withLock_(function(){
    var name=RadioCore.nickname(p.nickname),avatar=validAvatar_(p.avatar),ids=p.ids,answers=p.answers;
    if(String(p.version||'')!==RadioCore.version||!RadioCore.valid(ids,answers))throw Error('題目版本或答案不正確，請重新開始。');
    var requestId=validRequestId_(p.requestId),sheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CHANNEL_SHEET_),rows=dataRows_(sheet,CHANNEL_HEADERS_.length);
    for(var i=0;i<rows.length;i++)if(String(rows[i][8])===requestId)return {id:String(rows[i][0]),expiresAt:iso_(rows[i][6]),leaderboard:getLeaderboard_(String(rows[i][0])),baseUrl:webAppUrl_()};
    var id;do{id=Utilities.getUuid().replace(/-/g,'').slice(0,8).toUpperCase();}while(findChannelRow_(id));
    var created=new Date(),expires=new Date(created.getTime()+365*24*60*60*1000);
    sheet.appendRow([id,name,avatar,JSON.stringify(ids),JSON.stringify(answers),created,expires,RadioCore.version,requestId]);
    return {id:id,expiresAt:expires.toISOString(),leaderboard:[],baseUrl:webAppUrl_()};
  });
}

function getChannelPublic_(rawId){
  var row=findChannelRow_(validChannelId_(rawId));if(!row||new Date(row[6]).getTime()<=Date.now())throw Error('找不到這個頻道，可能已經過期。');
  var ids=parseJsonArray_(row[3]);
  return {id:String(row[0]),hostName:String(row[1]),hostAvatar:String(row[2]),ids:ids,createdAt:iso_(row[5]),expiresAt:iso_(row[6]),leaderboard:getLeaderboard_(String(row[0])),baseUrl:webAppUrl_()};
}

function submitGuess_(p){
  return withLock_(function(){
    var id=validChannelId_(p.id),row=findChannelRow_(id);if(!row||new Date(row[6]).getTime()<=Date.now())throw Error('找不到這個頻道，可能已經過期。');
    var ids=parseJsonArray_(row[3]),hostAnswers=parseJsonArray_(row[4]),guestAnswers=p.answers;
    if(String(p.version||'')!==RadioCore.version||!RadioCore.valid(ids,guestAnswers))throw Error('題目版本或答案不正確，請重新開始。');
    var name=RadioCore.nickname(p.nickname),avatar=validAvatar_(p.avatar),requestId=validRequestId_(p.requestId),sheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(PLAYER_SHEET_),rows=dataRows_(sheet,PLAYER_HEADERS_.length),existing=null,count=0;
    for(var i=0;i<rows.length;i++){if(String(rows[i][1])===id)count++;if(String(rows[i][9])===requestId)existing=rows[i];}
    var result;
    if(existing){guestAnswers=parseJsonArray_(existing[8]);result=RadioCore.score(ids,hostAnswers,guestAnswers);}
    else{
      if(count>=500)throw Error('這個頻道的參加人數已達上限。');
      result=RadioCore.score(ids,hostAnswers,guestAnswers);
      sheet.appendRow([Utilities.getUuid(),id,name,avatar,result.score,ids.length,new Date(),RadioCore.version,JSON.stringify(guestAnswers),requestId]);
      rebuildLeaderboard_();
    }
    return {score:result.score,points:result.points,hostAnswers:hostAnswers,guestAnswers:guestAnswers,leaderboard:getLeaderboard_(id)};
  });
}

function getLeaderboard_(id){
  var sheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(PLAYER_SHEET_),rows=dataRows_(sheet,PLAYER_HEADERS_.length).filter(function(r){return String(r[1])===id;});
  rows.sort(function(a,b){return Number(b[4])-Number(a[4])||new Date(a[6]).getTime()-new Date(b[6]).getTime();});
  return rows.slice(0,20).map(function(r,i){return {rank:i+1,nickname:String(r[2]),avatar:String(r[3]),score:Number(r[4]),createdAt:iso_(r[6])};});
}

function rebuildLeaderboard_(){
  var ss=SpreadsheetApp.getActiveSpreadsheet(),players=dataRows_(ss.getSheetByName(PLAYER_SHEET_),PLAYER_HEADERS_.length),channels=dataRows_(ss.getSheetByName(CHANNEL_SHEET_),CHANNEL_HEADERS_.length),hosts={};
  channels.forEach(function(r){hosts[String(r[0])]=String(r[1]);});
  players.sort(function(a,b){return String(a[1]).localeCompare(String(b[1]))||Number(b[4])-Number(a[4])||new Date(a[6]).getTime()-new Date(b[6]).getTime();});
  var last='',rank=0,out=players.map(function(r){var id=String(r[1]);rank=id===last?rank+1:1;last=id;return [rank,id,hosts[id]||'',String(r[2]),Number(r[4]),Number(r[5]),r[6],String(r[0])];});
  var sheet=ss.getSheetByName(RANK_SHEET_);if(sheet.getLastRow()>1)sheet.getRange(2,1,sheet.getLastRow()-1,RANK_HEADERS_.length).clearContent();if(out.length)sheet.getRange(2,1,out.length,RANK_HEADERS_.length).setValues(out);
}

function cleanupExpired_(){
  var props=PropertiesService.getScriptProperties(),last=Number(props.getProperty('lastCleanup')||0);if(Date.now()-last<6*60*60*1000)return;
  withLock_(function(){
    var ss=SpreadsheetApp.getActiveSpreadsheet(),channelSheet=ss.getSheetByName(CHANNEL_SHEET_),channelRows=dataRows_(channelSheet,CHANNEL_HEADERS_.length),expired={};
    for(var i=channelRows.length-1;i>=0;i--)if(new Date(channelRows[i][6]).getTime()<=Date.now()){expired[String(channelRows[i][0])]=true;channelSheet.deleteRow(i+2);}
    if(Object.keys(expired).length){var playerSheet=ss.getSheetByName(PLAYER_SHEET_),playerRows=dataRows_(playerSheet,PLAYER_HEADERS_.length);for(var j=playerRows.length-1;j>=0;j--)if(expired[String(playerRows[j][1])])playerSheet.deleteRow(j+2);rebuildLeaderboard_();}
    props.setProperty('lastCleanup',String(Date.now()));
  });
}

function dataRows_(sheet,width){var n=sheet.getLastRow()-1;return n>0?sheet.getRange(2,1,n,width).getValues():[];}
function findChannelRow_(id){var rows=dataRows_(SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CHANNEL_SHEET_),CHANNEL_HEADERS_.length);for(var i=0;i<rows.length;i++)if(String(rows[i][0])===id)return rows[i];return null;}
function validChannelId_(value){var id=String(value||'').trim().toUpperCase();if(!/^[A-F0-9]{8}$/.test(id))throw Error('頻道代碼不正確。');return id;}
function validAvatar_(value){var a=String(value||'');if(AVATARS_.indexOf(a)<0)throw Error('頭像不正確。');return a;}
function validRequestId_(value){var id=String(value||'');if(!/^[A-Za-z0-9-]{12,80}$/.test(id))throw Error('請求識別碼不正確。');return id;}
function parseJsonArray_(value){try{var v=JSON.parse(String(value));if(Array.isArray(v))return v;}catch(e){}throw Error('紀錄資料損壞。');}
function iso_(value){return new Date(value).toISOString();}
function webAppUrl_(){return ScriptApp.getService().getUrl()||'';}
function withLock_(fn){var lock=LockService.getScriptLock();if(!lock.tryLock(10000))throw Error('目前使用人數較多，請再試一次。');try{return fn();}finally{lock.releaseLock();}}
